# 换行符配置
# 文本文件使用 LF 换行符
* text=auto eol=lf

# 以下文件强制使用 LF 换行符
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf

# 二进制文件不进行换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
*.tar.gz binary
*.pdf binary
